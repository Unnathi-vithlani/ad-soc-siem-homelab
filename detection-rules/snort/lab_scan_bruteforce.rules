# Snort rules for the ad-soc-siem-homelab network (192.168.100.0/24)
# Author: Unnathi Vithlani   Date: 2026-10-03

alert tcp any any -> 192.168.100.0/24 any (msg:"LAB Possible TCP SYN port scan"; flags:S,12; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; metadata:mitre_technique_id T1046; sid:1000001; rev:1;)

alert tcp any any -> 192.168.100.0/24 3389 (msg:"LAB Possible RDP brute force"; flags:S,12; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; metadata:mitre_technique_id T1110; sid:1000002; rev:1;)
